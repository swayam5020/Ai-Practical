continue
if move < 0 or move >= 9 or board[move] != ' ':
print("Invalid move! Try again.")
continue
board[move] = 'X'
display_board()
if check_winner('X'):
print("Human Wins!")
break
if ' ' not in board:
print("Game Draw!")
break
print("AI is thinking...")
ai_move()
display_board()
if check_winner('O'):
print("AI Wins!")
break
if ' ' not in board:
