Experiment 5: Knapsack Problem Using Dynamic Programming
def knapsack(weights, values, capacity):
n = len(weights)
dp = [[0 for _ in range(capacity + 1)]
for _ in range(n + 1)]
for i in range(1, n + 1):
for w in range(capacity + 1):
if weights[i - 1] <= w:
dp[i][w] = max(
values[i - 1] +
dp[i - 1][w - weights[i - 1]],
dp[i - 1][w]
)
else:
dp[i][w] = dp[i - 1][w]
print("Maximum Value:", dp[n][capacity])
w = capacity
selected = []
for i in range(n, 0, -1):
if dp[i][w] != dp[i - 1][w]:
selected.append(i)
w -= weights[i - 1]
selected.reverse()
print("Selected Items:", selected)
weights = [1, 3, 4, 5]
values = [1, 4, 5, 7]
capacity = 7
knapsack(weights, values, capacity)
